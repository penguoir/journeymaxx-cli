FILENAME = ".journeymaxx"
STATUSES = ("pending", "approved", "changes_requested", "rejected")
LABELS = {
    "pending": "PENDING",
    "approved": "APPROVED",
    "changes_requested": "CHANGE REQUESTED",
    "rejected": "REJECTED",
}
NEEDS_CLAUDE = ("comment", "rejected", "edited", "reopened")


def now():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def hhmm(stamp):
    try:
        return datetime.fromisoformat(stamp).strftime("%H:%M")
    except (TypeError, ValueError):
        return ""


# ---------------------------------------------------------------- storage

def find_file(explicit):
    if explicit:
        return os.path.abspath(explicit)
    if os.environ.get("JOURNEYMAXX_FILE"):
        return os.path.abspath(os.environ["JOURNEYMAXX_FILE"])
    d = os.getcwd()
    while True:
        p = os.path.join(d, FILENAME)
        if os.path.isfile(p):
            return p
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    # No file yet. In a git worktree, put it in the main checkout so a Claude
    # session in a worktree and a reviewer in the main checkout share one file.
    try:
        common = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, timeout=5,
        )
        if common.returncode == 0 and common.stdout.strip().endswith("/.git"):
            return os.path.join(os.path.dirname(common.stdout.strip()), FILENAME)
    except (OSError, subprocess.SubprocessError):
        pass
    return os.path.join(os.getcwd(), FILENAME)


def empty():
    return {"version": 1, "next_id": 1, "journeys": []}


def parse(text):
    if not text.strip():
        return empty()
    data = json.loads(text)
    data.setdefault("version", 1)
    data.setdefault("journeys", [])
    data.setdefault("next_id", max([j["id"] for j in data["journeys"]] + [0]) + 1)
    return data


class Store:
    def __init__(self, path):
        self.path = path

    def read(self):
        try:
            with open(self.path, encoding="utf-8") as f:
                fcntl.flock(f, fcntl.LOCK_SH)
                return parse(f.read())
        except FileNotFoundError:
            return empty()

    def mutate(self, fn):
        fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
        with os.fdopen(fd, "r+", encoding="utf-8") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            data = parse(f.read())
            result = fn(data)
            f.seek(0)
            f.truncate()
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
        return result

    def mtime(self):
        try:
            return os.stat(self.path).st_mtime_ns
        except FileNotFoundError:
            return 0


def find(data, jid):
    for j in data["journeys"]:
        if j["id"] == jid:
            return j
    return None


def event(j, by, action, **extra):
    e = {"at": now(), "by": by, "action": action}
    e.update({k: v for k, v in extra.items() if v is not None})
    if by == "reviewer":
        e["seen"] = False  # flipped once `feedback` / `wait` has shown it to Claude
    j["history"].append(e)
    j["updated_at"] = e["at"]
    return e


def set_status(j, status):
    j["status"] = status
    if status != "pending":
        j[status + "_at"] = now()


def counts(data):
    c = {s: 0 for s in STATUSES}
    for j in data["journeys"]:
        c[j["status"]] = c.get(j["status"], 0) + 1
    return c


def summary(data):
    c = counts(data)
    return (f"{c['pending']} pending · {c['approved']} approved · "
            f"{c['changes_requested']} change requested · {c['rejected']} rejected")


# ---------------------------------------------------------------- parsing input

def clean_title(line):
    line = re.sub(r"^#+\s*", "", line.strip())
    m = re.fullmatch(r"\*\*(.+?)\*\*", line)
    return (m.group(1) if m else line).strip()


def split_title(chunk):
    lines = chunk.strip().splitlines()
    if not lines:
        return ("", "")
    return (clean_title(lines[0]), "\n".join(lines[1:]).strip())


def parse_journeys(text):
    s = text.strip()
    if s[:1] in ("[", "{"):
        try:
            data = json.loads(s)
        except ValueError:
            data = None
        if data is not None:
            if isinstance(data, dict):
                data = data.get("journeys", [data])
            out = []
            for item in data:
                if isinstance(item, str):
                    out.append(split_title(item))
                else:
                    out.append((str(item.get("title", "")).strip(), str(item.get("body", "")).strip()))
            return out
    return [split_title(c) for c in re.split(r"(?m)^\s*---+\s*$", text) if c.strip()]


# ---------------------------------------------------------------- commands for Claude

def stdin_text():
    return "" if sys.stdin.isatty() else sys.stdin.read()


def cmd_add(store, args):
    if args.title:
        body = args.body if args.body is not None else stdin_text()
        items = [(args.title.strip(), body.strip())]
    else:
        items = parse_journeys(args.body if args.body is not None else stdin_text())
    items = [(t, b) for t, b in items if t or b]
    if not items:
        sys.exit("journeymaxx: nothing to add. Pipe markdown (journeys split by a --- line, "
                 "first line is the title) or a JSON array of {title, body}.")

    def fn(data):
        ids = []
        for title, body in items:
            stamp = now()
            j = {"id": data["next_id"], "title": title, "body": body, "status": "pending",
                 "created_at": stamp, "updated_at": stamp, "approved_at": None,
                 "rejected_at": None, "changes_requested_at": None, "history": []}
            event(j, "claude", "added")
            data["next_id"] += 1
            data["journeys"].append(j)
            ids.append(j["id"])
        return ids, summary(data)

    ids, summ = store.mutate(fn)
    span = f"#{ids[0]}" if len(ids) == 1 else f"#{ids[0]}–#{ids[-1]}"
    print(f"added {len(ids)} ({span}) to {store.path}")
    print(summ)
    print(f"review with: journeymaxx -f {shlex.quote(store.path)}")


def need(data, jid):
    j = find(data, jid)
    if j is None:
        sys.exit(f"journeymaxx: no journey #{jid}")
    return j


def cmd_revise(store, args):
    body = args.body if args.body is not None else stdin_text()
    if not body.strip() and not args.title:
        sys.exit("journeymaxx: give the new text on stdin (or --body), and/or --title")

    def fn(data):
        j = need(data, args.id)
        prev_title, prev_body = j["title"], j["body"]
        if args.title:
            j["title"] = args.title.strip()
        if body.strip():
            j["body"] = body.strip()
        event(j, "claude", "revised", message=args.message,
              previous_title=prev_title, previous_body=prev_body)
        set_status(j, "pending")

    store.mutate(fn)
    print(f"#{args.id} revised, back to pending")


def cmd_reply(store, args):
    """A note on the thread. It does not come back into the review queue."""
    def fn(data):
        j = need(data, args.id)
        event(j, "claude", "reply", message=args.message)
        return j["status"]

    status = store.mutate(fn)
    print(f"#{args.id} note added; it stays {status} and out of the review queue. "
          "Use `ask` only for a question, pushback or contradiction the reviewer must answer.")


def cmd_ask(store, args):
    """A question or pushback the reviewer has to answer: back to pending."""
    def fn(data):
        j = need(data, args.id)
        event(j, "claude", "question", message=args.message)
        set_status(j, "pending")

    store.mutate(fn)
    print(f"#{args.id} question sent, back to pending")


def collect_feedback(data, mark):
    out = []
    for j in data["journeys"]:
        evs = [e for e in j["history"] if e.get("by") == "reviewer" and e.get("seen") is False]
        if not evs:
            continue
        out.append({"id": j["id"], "title": j["title"], "body": j["body"], "status": j["status"],
                    "events": [{k: e[k] for k in ("at", "action", "message") if k in e} for e in evs]})
        if mark:
            for e in evs:
                e["seen"] = True
    return out


def print_feedback(items, data, as_json):
    if as_json:
        print(json.dumps({"feedback": items, "counts": counts(data)}, indent=2, ensure_ascii=False))
        return
    quiet = [i for i in items if all(e["action"] == "approved" for e in i["events"])]
    loud = [i for i in items if i not in quiet]
    if quiet:
        print("approved: " + " ".join(f"#{i['id']}" for i in quiet))
    for i in loud:
        print(f"\n#{i['id']} [{i['status']}] {i['title']}")
        for e in i["events"]:
            msg = e.get("message")
            if e["action"] == "comment":
                print(f"  comment: {msg}")
            elif e["action"] == "rejected":
                print("  rejected" + (f": {msg}" if msg else ""))
            elif e["action"] == "edited":
                print("  edited by the reviewer; the text is now:")
                print(textwrap.indent(f"{i['title']}\n\n{i['body']}", "    | "))
            else:
                print(f"  {e['action']}" + (f": {msg}" if msg else ""))
    if not items:
        print("no new feedback")
    print("\n" + summary(data))


def cmd_feedback(store, args):
    if args.peek:
        data = store.read()
        items = collect_feedback(data, mark=False)
    else:
        items, data = store.mutate(lambda d: (collect_feedback(d, mark=True), d))
    print_feedback(items, data, args.json)


def cmd_wait(store, args):
    deadline = time.time() + args.timeout if args.timeout else None
    seen_mtime = None
    while True:
        m = store.mtime()
        if m != seen_mtime:
            seen_mtime = m
            data = store.read()
            unseen = [e for j in data["journeys"] for e in j["history"]
                      if e.get("by") == "reviewer" and e.get("seen") is False]
            if any(e["action"] in NEEDS_CLAUDE for e in unseen) or counts(data)["pending"] == 0:
                args.peek = False
                cmd_feedback(store, args)
                return
        if deadline and time.time() > deadline:
            print(f"no feedback yet ({summary(store.read())})")
            sys.exit(2)
        time.sleep(1)


def cmd_list(store, args):
    data = store.read()
    js = [j for j in data["journeys"] if not args.status or j["status"] == args.status]
    if args.json:
        print(json.dumps(js, indent=2, ensure_ascii=False))
        return
    for j in js:
        print(f"#{j['id']:<4} {j['status']:<18} {j['title']}")
    print(summary(data))
    print(store.path)


def cmd_show(store, args):
    j = need(store.read(), args.id)
    print(f"#{j['id']} [{j['status']}] {j['title']}\n\n{j['body']}")
    thread = [e for e in j["history"] if e["action"] != "added"]
    if thread:
        print()
    for e in thread:
        print(f"  {e['at']} {e['by']} {e['action']}" + (f": {e['message']}" if e.get("message") else ""))


def cmd_export(store, args):
    js = [j for j in store.read()["journeys"] if args.status == "all" or j["status"] == args.status]
    print("\n\n".join(f"**{j['title']}**\n\n{j['body']}".strip() for j in js))


