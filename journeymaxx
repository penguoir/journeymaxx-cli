class BrowserMic:
    """For an SSH session with no sound card: a page on localhost records and plays in your browser."""
    kind = "browser"

    def __init__(self):
        self.cv = threading.Condition()
        self.v, self.seq, self.recording, self.auto, self.last_seen = 0, 0, False, False, 0.0
        self.play, self.play_n, self.played_n, self.tts = None, 0, 0, {}
        self.audio = {}
        self.requested = self.stop_requested = self.heard = False
        for port in range(MIC_PORT, MIC_PORT + 10):
            try:
                self.server = ThreadingHTTPServer(("127.0.0.1", port), self.handler(self))
                break
            except OSError:
                continue
        else:
            raise VoiceError(f"ports {MIC_PORT}-{MIC_PORT + 9} are all in use")
        self.server.daemon_threads = True
        self.port = self.server.server_address[1]
        self.url = f"http://localhost:{self.port}"
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    def bump(self):  # call holding cv: wakes the page's long poll
        self.v += 1
        self.cv.notify_all()

    @staticmethod
    def handler(mic):
        class H(BaseHTTPRequestHandler):
            def log_message(self, *a):  # stderr would draw over the TUI
                pass

            def send(self, code, body, ctype="application/json"):
                body = body.encode() if isinstance(body, str) else body
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)

            def query(self):
                return dict(urllib.parse.parse_qsl(urllib.parse.urlparse(self.path).query))

            def local_origin(self):
                origin = self.headers.get("Origin")
                return not origin or urllib.parse.urlparse(origin).hostname in ("localhost", "127.0.0.1")

            def do_GET(self):
                route, q = urllib.parse.urlparse(self.path).path, self.query()
                if route == "/":
                    return self.send(200, MIC_PAGE.replace("__PAUSE__", str(PAUSE)), "text/html; charset=utf-8")
                if route == "/tts":
                    data = mic.tts.get(int(q.get("n", 0) or 0))
                    return self.send(200, data, "audio/mpeg") if data else self.send(404, "{}")
                if route == "/poll":
                    have = int(q.get("v", -1) or -1)
                    with mic.cv:
                        mic.last_seen = time.time()
                        mic.cv.wait_for(lambda: mic.v != have, timeout=20)
                        mic.last_seen = time.time()
                        play = mic.play and {k: mic.play[k] for k in ("n", "text", "audio")}
                        state = {"v": mic.v, "seq": mic.seq, "recording": mic.recording,
                                 "auto": mic.auto, "play": play}
                    return self.send(200, json.dumps(state))
                self.send(404, "{}")

            def do_POST(self):
                if not self.local_origin():
                    return self.send(403, "{}")
                route, q = urllib.parse.urlparse(self.path).path, self.query()
                body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
                n = int(q.get("seq", q.get("n", 0)) or 0)
                with mic.cv:
                    if route == "/toggle":
                        if mic.recording:
                            mic.stop_requested = True
                        elif mic.play:
                            mic.played_n = mic.play_n  # "answer now" while it is speaking
                        else:
                            mic.requested = True
                    elif route == "/heard" and n == mic.seq:
                        mic.heard = True
                    elif route == "/silence" and n == mic.seq:
                        mic.stop_requested = True
                    elif route == "/played":
                        mic.played_n = max(mic.played_n, n)
                    elif route == "/audio":
                        mic.audio[n] = (body, self.headers.get("Content-Type", "audio/webm"), q.get("error"))
                    else:
                        return self.send(404, "{}")
                    mic.cv.notify_all()
                self.send(200, "{}")
        return H

    def ready(self):
        return time.time() - self.last_seen < 30

    def hint(self):
        return (f"open {self.url} in a browser to talk (over SSH forward it first: "
                f"ssh -L {self.port}:localhost:{self.port} <this host>)")

    def start(self, auto=False):
        if not self.ready():
            raise VoiceError(self.hint())
        with self.cv:
            self.seq += 1
            self.recording, self.auto = True, auto
            self.requested = self.stop_requested = self.heard = False
            self.bump()

    def stop(self):
        with self.cv:
            self.recording = False
            self.bump()
            n = self.seq
            if not self.cv.wait_for(lambda: n in self.audio, timeout=20):
                raise VoiceError("the browser did not send the recording")
            audio, ctype, err = self.audio.pop(n)
        if err:
            raise VoiceError(f"browser microphone: {err}")
        return audio, ctype

    def cancel(self):
        with self.cv:
            self.recording = self.stop_requested = False
            self.audio.clear()
            self.bump()

    def say(self, text):
        if not self.ready():
            raise VoiceError(self.hint())
        p = SPEECH.audio(text)
        data = None
        if p:
            with open(p, "rb") as f:
                data = f.read()
        with self.cv:
            self.play_n += 1
            self.tts = {self.play_n: data} if data else {}
            self.play = {"n": self.play_n, "text": text, "audio": bool(data)}
            self.bump()

    def speaking(self):
        with self.cv:
            if self.play and self.played_n >= self.play["n"]:
                self.play = None
                self.bump()
            return self.play is not None

    def hush(self):
        with self.cv:
            if self.play:
                self.played_n, self.play = self.play["n"], None
                self.bump()


def make_mic():
    """JOURNEYMAXX_MIC=local|browser; by default the browser over SSH, else this machine."""
    choice = os.environ.get("JOURNEYMAXX_MIC", "").lower()
    if not choice:
        over_ssh = os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY")
        choice = "browser" if over_ssh or not which("ffmpeg") else "local"
    return BrowserMic() if choice == "browser" else LocalMic()


# ---------------------------------------------------------------- talking through the queue

APPROVE_WORDS = {"yes", "yeah", "yep", "yup", "good", "great", "perfect", "fine", "approve", "approved",
                 "ok", "okay", "nice", "correct", "lgtm", "cool", "brilliant", "lovely", "excellent",
                 "agreed", "accept", "accepted", "sure", "spot", "love", "ship", "happy", "sounds"}
APPROVE_FILLER = {"looks", "look", "that", "that's", "thats", "it", "it's", "its", "this", "is", "all", "very",
                  "really", "pretty", "on", "with", "one", "me", "to", "fine", "please", "a", "the", "good"}
REJECT_WORDS = {"no", "nope", "nah", "reject", "rejected", "drop", "bin", "kill", "scrap", "delete", "remove",
                "cut", "lose", "rid"}
REJECT_FILLER = {"it", "this", "that", "one", "get", "rid", "of", "please", "the"}
SKIP = {"skip", "skip it", "skip this", "next", "next one", "later", "come back to it",
        "come back to that", "pass", "not sure"}
REPEAT = {"repeat", "again", "say again", "say that again", "read it again", "what", "pardon",
          "sorry", "come again", "repeat that", "what was that"}
UNDO = {"undo", "go back", "back", "previous", "wait go back", "undo that"}
STOP = {"stop", "pause", "that's all", "thats all", "that's it for now", "exit", "quit", "stop talking"}
FILLERS = {"um", "uh", "erm", "er", "hmm", "so", "oh", "ah", "right", "okay so"}
TRAILING = {"thanks", "thank", "you", "please", "cheers", "mate"}


def intent(text):
    """What a spoken answer means: (action, message). Short yes/no answers decide; anything
    with more in it goes to Claude as a comment."""
    words = re.sub(r"[^a-z0-9' ]+", " ", text.lower()).split()
    while len(words) > 1 and words[0] in FILLERS:
        words.pop(0)
    while len(words) > 1 and words[-1] in TRAILING:
        words.pop()
    p, w = " ".join(words), set(words)
    for name, phrases in (("skip", SKIP), ("repeat", REPEAT), ("undo", UNDO), ("stop", STOP)):
        if p in phrases:
            return name, None
    if w & APPROVE_WORDS and not w & REJECT_WORDS and w <= APPROVE_WORDS | APPROVE_FILLER:
        return "approve", None
    if w & REJECT_WORDS and not w & APPROVE_WORDS and w <= REJECT_WORDS | REJECT_FILLER:
        return "reject", None
    m = re.match(r"(?i)^\W*(reject|drop|bin|scrap|kill)( (it|this|that))?\b[\s,.:;-]*"
                 r"((because|as|since)\b)?[\s,]*(.+)$", text.strip())
    if m and m.group(6).strip():
        return "reject", m.group(6).strip()
    return "comment", text.strip()


def script(j):
    """What talk mode says to put a journey in front of you."""
    last = next((e for e in reversed(j["history"]) if e["by"] == "claude"
                 and e["action"] in ("revised", "question")), None)
    body = speakable(j["body"])
    if last and last["action"] == "question":
        return f"Claude asks about number {j['id']}, {j['title']}: {last.get('message', '')}"
    if last and last["action"] == "revised":
        note = f" Claude says: {last['message'].rstrip('.')}." if last.get("message") else ""
        return f"Number {j['id']}, revised.{note} {j['title']}. {body}"
    return f"Number {j['id']}. {j['title']}. {body}"


ACKS = {"approve": "Approved.", "reject": "Rejected.", "comment": "Sent to Claude.", "skip": "Skipped."}


# ---------------------------------------------------------------- TUI

def md_lines(text, width, base=0):
    """Wrap light markdown (bullets, **bold**, # headings) into rows of (text, attr) segments."""
    rows = []
    for raw in text.splitlines():
        if not raw.strip():
            rows.append([])
            continue
        attr = base
        first, rest = "", ""
        m = re.match(r"^(\s*)([-*•]|\d+[.)])\s+", raw)
        h = re.match(r"^#+\s+", raw)
        if m:
            marker = "•" if m.group(2) in "-*•" else m.group(2)
            first = m.group(1) + marker + " "
            rest = " " * len(first)
            raw = raw[m.end():]
        elif h:
            raw = raw[h.end():]
            attr |= curses.A_BOLD
        tokens = []  # (word, attr, space_before)
        for n, part in enumerate(raw.split("**")):
            a = attr | (curses.A_BOLD if n % 2 else 0)
            for piece in re.findall(r"\s+|\S+", part):
                if piece.isspace():
                    tokens.append(None)
                else:
                    tokens.append((piece, a))
        row, used, gap = [(first, base)] if first else [], len(first), False
        start = used  # where words begin on the current row
        for tok in tokens:
            if tok is None:
                gap = True
                continue
            word, a = tok
            lead = " " if gap and used > start else ""
            if used + len(lead) + len(word) > width and used > start:
                rows.append(row)
                row, used, lead = ([(rest, base)] if rest else []), len(rest), ""
                start = used
            row.append((lead + word, a))
            used += len(lead) + len(word)
            gap = False
        rows.append(row)
    return rows


class Review:
    def __init__(self, scr, store):
        self.scr = scr
        self.store = store
        self.data = empty()
        self.mtime = None
        self.cur = None       # id of the journey on screen; None = caught-up screen
        self.scroll = 0
        self.diff = False
        self.flash = ""
        self.color = {}
        self.mic = None
        self.mic_error = ""
        self.talking = False
        self.said_fallback = False
        self.voice_failed = False
        self.autotalk = False
        try:
            self.mic = make_mic()
        except VoiceError as e:
            self.mic_error = str(e)

    # -- state

    def reload(self):
        self.mtime = self.store.mtime()
        try:
            self.data = self.store.read()
        except ValueError:
            self.flash = "could not read the file (invalid JSON)"

    def journey(self):
        return find(self.data, self.cur) if self.cur is not None else None

    def goto(self, jid):
        if jid != self.cur:
            self.cur, self.scroll, self.diff = jid, 0, False

    def next_pending(self):
        js = self.data["journeys"]
        idx = next((i for i, j in enumerate(js) if j["id"] == self.cur), -1)
        order = js[idx + 1:] + js[:idx + 1]
        nxt = next((j for j in order if j["status"] == "pending" and j["id"] != self.cur), None)
        self.goto(nxt["id"] if nxt else None)

    def step(self, delta):
        js = self.data["journeys"]
        if not js:
            return
        idx = next((i for i, j in enumerate(js) if j["id"] == self.cur), None)
        if idx is None:
            idx = 0 if delta > 0 else len(js) - 1
        else:
            idx = max(0, min(len(js) - 1, idx + delta))
        self.goto(js[idx]["id"])

    def change(self, fn):
        jid = self.cur

        def wrapped(data):
            j = find(data, jid)
            if j is not None:
                fn(j)

        self.store.mutate(wrapped)
        self.reload()

    # -- actions

    def approve(self):
        j = self.journey()
        if j is None:
            return
        if j["status"] != "approved":
            self.change(lambda j: (set_status(j, "approved"), event(j, "reviewer", "approved")))
            self.flash = f"#{j['id']} approved"
        self.next_pending()

    def comment(self, initial=""):
        j = self.journey()
        if j is None:
            return
        text = self.prompt(f"Message to Claude about #{j['id']}", initial=initial)
        if not text:
            return
        self.change(lambda j: (set_status(j, "changes_requested"),
                               event(j, "reviewer", "comment", message=text)))
        self.flash = f"#{j['id']} sent to Claude"
        self.next_pending()

    def listen(self, auto=False):
        """Record and transcribe. auto: stop on a pause instead of enter.
        Returns the text, "" when nothing came of it (see self.flash), None when cancelled."""
        self.voice_failed = False
        if self.mic is None:
            self.flash, self.voice_failed = self.mic_error, True
            return ""
        try:
            self.mic.start(auto=auto)
        except VoiceError as e:
            self.mic.requested = False
            self.flash, self.voice_failed = str(e), True
            return ""
        started = time.time()
        keys = ("pause to answer · enter answer now · esc stop talking" if auto
                else "enter stop and send to the message box · esc cancel")
        self.scr.timeout(150)
        try:
            while True:
                waited = time.time() - started
                self.status_line(f"● Listening {int(waited)}s", keys, "rejected")
                try:
                    ch = self.scr.get_wch()
                except curses.error:
                    ch = None
                except KeyboardInterrupt:
                    ch = "\x1b"
                if ch == "\x1b":
                    self.mic.cancel()
                    self.flash = "recording cancelled"
                    return None
                if ch in ("\n", "\r", curses.KEY_ENTER, " ") or (ch == "v" and not auto) \
                        or self.mic.stop_requested or waited > 120:
                    break
                if auto and not self.mic.heard and waited > 20:
                    self.mic.cancel()  # nobody spoke; start again rather than pay to transcribe silence
                    return ""
            self.status_line("Transcribing…", "", "claude")
            audio, ctype = self.mic.stop()
            text = transcribe(audio, ctype)
        except VoiceError as e:
            self.mic.cancel()
            self.flash, self.voice_failed = str(e), True
            return ""
        finally:
            self.scr.timeout(400)
        if not text:
            self.flash = "did not catch anything"
        return text

    def voice(self):
        if self.journey() is None:
            if self.mic:
                self.mic.requested = False
            return
        text = self.listen()
        if text:
            self.comment(initial=text)

    def say(self, text):
        """Speak, keeping the screen alive. Returns "done", "skip" (answer now) or "stop"."""
        try:
            self.mic.say(text)
        except VoiceError as e:
            self.flash = str(e)
            return "done"
        if SPEECH.failed and not self.said_fallback:
            self.said_fallback = True
            self.flash = f"ElevenLabs voice unavailable, using the free one ({SPEECH.failed})"
        deadline = time.time() + 10 + len(text) / 8
        self.scr.timeout(120)
        try:
            while self.mic.speaking() and time.time() < deadline:
                self.status_line("▶ Speaking", "space answer now · esc stop talking", "claude")
                try:
                    ch = self.scr.get_wch()
                except curses.error:
                    continue
                except KeyboardInterrupt:
                    ch = "\x1b"
                if ch == "\x1b":
                    self.mic.hush()
                    return "stop"
                if ch in (" ", "\n", "\r", curses.KEY_ENTER):
                    self.mic.hush()
                    return "skip"
            self.mic.hush()
            return "done"
        finally:
            self.scr.timeout(400)

    def talk(self):
        """Hands-free: read each pending journey out, listen, act on the answer, move on."""
        if self.mic is None:
            self.flash = self.mic_error
            return
        if not self.mic.ready():
            self.flash = self.mic.hint()
            return
        self.talking = True
        SPEECH.prefetch(*ACKS.values(), "Undone.", "All caught up. I'll read out what Claude sends back.")
        spoken, last, failures, caught_up = None, None, 0, False
        n = counts(self.data)["pending"]
        intro = f"{n} to review. " if n > 1 else ""
        try:
            while True:
                if self.store.mtime() != self.mtime:
                    self.reload()
                j = self.journey()
                if j is None or j["status"] != "pending":
                    self.next_pending()
                    j = self.journey()
                if j is None:
                    if not caught_up:
                        caught_up = True
                        if self.say("All caught up. I'll read out what Claude sends back.") == "stop":
                            return
                    self.status_line("All caught up · waiting for Claude", "esc stop talking", "claude")
                    try:
                        if self.scr.get_wch() == "\x1b":
                            return
                    except curses.error:
                        pass
                    continue
                caught_up = False
                if spoken != j["id"]:
                    spoken = j["id"]
                    if self.say(intro + script(j)) == "stop":
                        return
                    intro = ""
                    nxt = self.peek_next(j["id"])
                    if nxt:
                        SPEECH.prefetch(script(nxt))
                text = self.listen(auto=True)
                if text is None:
                    return
                if not text:
                    failures = failures + 1 if self.voice_failed else 0
                    if failures >= 2:
                        return
                    continue
                failures = 0
                action, msg = intent(text)
                self.flash = f"heard: {text}"
                if action == "stop":
                    return
                if action == "repeat":
                    spoken = None
                    continue
                if action == "undo":
                    if last is None:
                        self.say("Nothing to undo.")
                        continue
                    self.goto(last)
                    self.change(lambda j: (set_status(j, "pending"), event(j, "reviewer", "reopened")))
                    last, spoken = None, None
                    if self.say("Undone.") == "stop":
                        return
                    continue
                if action == "approve":
                    self.change(lambda j: (set_status(j, "approved"), event(j, "reviewer", "approved")))
                elif action == "reject":
                    self.change(lambda j: (set_status(j, "rejected"),
                                           event(j, "reviewer", "rejected", message=msg)))
                elif action == "comment":
                    self.change(lambda j: (set_status(j, "changes_requested"),
                                           event(j, "reviewer", "comment", message=msg)))
                last = j["id"] if action != "skip" else last
                self.next_pending()
                spoken = None
                if self.say(ACKS[action]) == "stop":
                    return
        finally:
            self.talking = False
            if self.mic:
                self.mic.hush()
            self.flash = "stopped talking · t to start again"

    def peek_next(self, jid):
        js = self.data["journeys"]
        idx = next((i for i, j in enumerate(js) if j["id"] == jid), -1)
        return next((j for j in js[idx + 1:] + js[:idx + 1]
                     if j["status"] == "pending" and j["id"] != jid), None)

    def status_line(self, msg, keys, color):
        self.draw()
        h, _ = self.scr.getmaxyx()
        for y in (h - 2, h - 1):
            self.scr.move(y, 0)
            self.scr.clrtoeol()
        self.put(h - 2, 2, msg, self.color.get(color, 0) | curses.A_BOLD)
        self.put(h - 1, 1, keys, curses.A_DIM)
        self.scr.refresh()

    def reject(self):
        j = self.journey()
        if j is None:
            return
        text = self.prompt(f"Reject #{j['id']}: reason (enter to skip)", allow_empty=True)
        if text is None:
            return
        self.change(lambda j: (set_status(j, "rejected"),
                               event(j, "reviewer", "rejected", message=text or None)))
        self.flash = f"#{j['id']} rejected"
        self.next_pending()

    def reopen(self):
        j = self.journey()
        if j is None or j["status"] == "pending":
            return
        self.change(lambda j: (set_status(j, "pending"), event(j, "reviewer", "reopened")))
        self.flash = f"#{j['id']} back to pending"

    def edit(self):
        j = self.journey()
        if j is None:
            return
        new = self.editor(f"# {j['title']}\n\n{j['body']}\n")
        if new is None:
            return
        title, body = split_title(new)
        if (title, body) == (j["title"], j["body"]):
            self.flash = "no changes"
            return

        def fn(j):
            prev_title, prev_body = j["title"], j["body"]
            j["title"], j["body"] = title, body
            event(j, "reviewer", "edited", previous_title=prev_title, previous_body=prev_body)

        self.change(fn)
        self.flash = f"#{j['id']} edited · enter to approve"

    def editor(self, text):
        cmd = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vim")
        fd, path = tempfile.mkstemp(prefix="journeymaxx-", suffix=".md")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(text)
            curses.endwin()
            try:
                code = subprocess.call(cmd + [path])
            except OSError as e:
                self.flash = f"could not start {cmd[0]}: {e}"
                return None
            finally:
                self.scr.refresh()
                curses.curs_set(0)
            if code != 0:
                self.flash = "edit cancelled"
                return None
            with open(path, encoding="utf-8") as f:
                return f.read()
        finally:
            os.unlink(path)

    # -- drawing

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w - 1:
            try:
                self.scr.addnstr(y, x, text, w - 1 - x, attr)
            except curses.error:
                pass

    def status_attr(self, status):
        return self.color.get(status, 0) | curses.A_BOLD

    def content(self, j, width):
        dim = curses.A_DIM
        rows = md_lines(f"#{j['id']}  {j['title']}", width, curses.A_BOLD)
        badge = [(LABELS[j["status"]], self.status_attr(j["status"]))]
        last = j["history"][-1] if j["history"] else None
        if last and last["by"] == "claude" and last["action"] in ("revised", "reply", "question"):
            what = {"revised": "revised", "reply": "left a note", "question": "has a question"}[last["action"]]
            badge.append((f"  · Claude {what} {hhmm(last['at'])}", self.color.get("claude", 0)))
        rows += [badge, []]

        prev = next((e for e in reversed(j["history"]) if "previous_body" in e), None)
        if self.diff and prev:
            old = f"{prev.get('previous_title', '')}\n\n{prev['previous_body']}".splitlines()
            new = f"{j['title']}\n\n{j['body']}".splitlines()
            for line in difflib.ndiff(old, new):
                if line.startswith("?"):
                    continue
                attr = {"+": self.color.get("approved", 0), "-": self.color.get("rejected", 0)}.get(line[0], dim)
                for n, part in enumerate(textwrap.wrap(line[2:], width - 2) or [""]):
                    rows.append([((line[0] if n == 0 else " ") + " " + part, attr)])
        else:
            rows += md_lines(j["body"], width)

        thread = [e for e in j["history"] if e["action"] != "added"]
        if thread:
            rows += [[], [("─" * min(width, 40), dim)]]
        for e in thread:
            who = "you" if e["by"] == "reviewer" else "claude"
            attr = 0 if e["by"] == "reviewer" else self.color.get("claude", 0)
            head = f"{hhmm(e['at'])} {who} {e['action'].replace('_', ' ')}"
            if e.get("message"):
                msg = md_lines(e["message"], width - 4)
                rows.append([(head + ":", attr | curses.A_BOLD)])
                rows += [[("    ", 0)] + r for r in msg]
            else:
                rows.append([(head, attr | dim)])
        return rows, bool(prev)

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        width = max(20, min(w - 4, 92))
        js = self.data["journeys"]
        j = self.journey()

        pos = ""
        if j is not None:
            pos = f"{next(i for i, x in enumerate(js) if x['id'] == j['id']) + 1}/{len(js)}"
        self.put(0, 1, "journeymaxx", curses.A_BOLD)
        self.put(0, 14, summary(self.data), curses.A_DIM)
        self.put(0, max(14, w - len(pos) - 2), pos, curses.A_DIM)
        if self.mic and self.mic.kind == "browser":
            mic = "mic ready" if self.mic.ready() else f"mic: open {self.mic.url}"
            self.put(1, max(14, w - len(mic) - 2), mic, curses.A_DIM)

        keys = "↑↓ move · q quit"
        if j is None:
            if not js:
                msg, sub = "No journeys yet.", f"Waiting for Claude to add some to {self.store.path}"
            else:
                msg, sub = "All caught up.", "New and revised journeys show up here as Claude adds them."
            self.put(h // 2 - 1, 2, msg, curses.A_BOLD)
            self.put(h // 2, 2, sub, curses.A_DIM)
        else:
            rows, has_prev = self.content(j, width)
            avail = max(1, h - 5)
            self.scroll = max(0, min(self.scroll, len(rows) - avail))
            for n, row in enumerate(rows[self.scroll:self.scroll + avail]):
                x = 2
                for text, attr in row:
                    self.put(2 + n, x, text, attr)
                    x += len(text)
            if self.scroll + avail < len(rows):
                self.put(h - 3, 2, "▼ more (space)", curses.A_DIM)
            keys = ("enter approve · c message Claude · t talk it through · v speak · ^G edit · r reject · u undo"
                    + (" · d diff" if has_prev else "") + " · ↑↓ move · n next pending · q quit")
        if self.flash:
            self.put(h - 2, 2, self.flash, self.color.get("approved", 0))
        self.put(h - 1, 1, keys, curses.A_DIM)
        scr.refresh()

    def prompt(self, label, allow_empty=False, initial=""):
        """One-field input at the bottom. Returns the text, or None when cancelled."""
        buf = initial
        self.scr.timeout(-1)
        curses.curs_set(1)
        try:
            while True:
                self.draw()
                h, w = self.scr.getmaxyx()
                width = max(10, w - 6)
                lines = []
                for para in (buf + "█").split("\n"):
                    lines += textwrap.wrap(para, width, drop_whitespace=False) or [""]
                lines = lines[-max(1, h - 6):]
                top = h - len(lines) - 3
                for y in range(top, h):
                    self.scr.move(max(0, y), 0)
                    self.scr.clrtoeol()
                self.put(top, 1, label, curses.A_BOLD)
                for n, line in enumerate(lines):
                    self.put(top + 1 + n, 1, "> " if n == 0 else "  ", curses.A_DIM)
                    self.put(top + 1 + n, 3, line.replace("█", ""))
                last = lines[-1].replace("█", "")
                self.put(h - 1, 1, "enter send · esc cancel · ^R speak · ^G write in editor", curses.A_DIM)
                try:
                    self.scr.move(top + len(lines), min(w - 2, 3 + len(last)))
                except curses.error:
                    pass
                self.scr.refresh()
                try:
                    ch = self.scr.get_wch()
                except curses.error:
                    continue
                except KeyboardInterrupt:
                    return None
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    text = buf.strip()
                    if text or allow_empty:
                        return text
                    return None
                if ch == "\x1b":
                    return None
                if ch == "\x07":
                    edited = self.editor(buf)
                    if edited is not None:
                        buf = edited.strip()
                elif ch == "\x12":
                    curses.curs_set(0)
                    said = self.listen()
                    self.scr.timeout(-1)
                    curses.curs_set(1)
                    if said:
                        buf = (buf.rstrip() + " " + said).strip()
                elif ch in ("\x7f", "\b", curses.KEY_BACKSPACE):
                    buf = buf[:-1]
                elif ch == "\x15":
                    buf = ""
                elif ch == "\x17":
                    buf = re.sub(r"\S*\s*$", "", buf)
                elif isinstance(ch, str) and ch.isprintable():
                    buf += ch
        finally:
            curses.curs_set(0)
            self.scr.timeout(400)

    # -- loop

    def run(self):
        curses.curs_set(0)
        curses.set_escdelay(25)
        try:
            curses.use_default_colors()
            for n, (name, col) in enumerate([("approved", curses.COLOR_GREEN),
                                             ("changes_requested", curses.COLOR_YELLOW),
                                             ("rejected", curses.COLOR_RED),
                                             ("pending", curses.COLOR_CYAN),
                                             ("claude", curses.COLOR_MAGENTA)], start=1):
                curses.init_pair(n, col, -1)
                self.color[name] = curses.color_pair(n)
        except curses.error:
            pass
        self.scr.timeout(400)
        self.reload()
        self.next_pending()
        while True:
            if self.store.mtime() != self.mtime:
                self.reload()
            if self.cur is not None and self.journey() is None:
                self.cur = None
            if self.cur is None:
                self.next_pending()  # jump to new work as soon as Claude adds it
            if self.autotalk and self.mic and self.mic.ready():
                self.autotalk = False
                self.talk()
                continue
            if self.mic and self.mic.requested:  # "Talk" pressed on the mic page
                self.voice()
                continue
            self.draw()
            try:
                ch = self.scr.get_wch()
            except curses.error:
                continue
            except KeyboardInterrupt:
                return
            self.flash = ""
            if ch in ("q", "Q"):
                return
            elif ch in ("\n", "\r", curses.KEY_ENTER):
                self.approve()
            elif ch in ("c", "C"):
                self.comment()
            elif ch in ("v", "V"):
                self.voice()
            elif ch in ("t", "T"):
                self.talk()
            elif ch in ("\x07", "e"):
                self.edit()
            elif ch == "r":
                self.reject()
            elif ch == "u":
                self.reopen()
            elif ch == "d":
                self.diff, self.scroll = not self.diff, 0
            elif ch in ("j", curses.KEY_DOWN, curses.KEY_RIGHT):
                self.step(1)
            elif ch in ("k", curses.KEY_UP, curses.KEY_LEFT):
                self.step(-1)
            elif ch == "n":
                self.next_pending()
            elif ch == "g":
                self.cur = None
                self.step(1)
            elif ch == "G":
                self.cur = None
                self.step(-1)
            elif ch in (" ", curses.KEY_NPAGE):
                self.scroll += max(1, self.scr.getmaxyx()[0] - 7)
            elif ch in ("b", curses.KEY_PPAGE):
                self.scroll = max(0, self.scroll - max(1, self.scr.getmaxyx()[0] - 7))


def cmd_transcribe(store, args):
    ctype = {".webm": "audio/webm", ".ogg": "audio/ogg", ".mp3": "audio/mpeg", ".mp4": "audio/mp4",
             ".m4a": "audio/mp4"}.get(os.path.splitext(args.audio)[1].lower(), "audio/wav")
    try:
        with open(args.audio, "rb") as f:
            print(transcribe(f.read(), ctype))
    except (OSError, VoiceError) as e:
        sys.exit(f"journeymaxx: {e}")


def cmd_review(store, args):
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        args.status, args.json = None, False
        return cmd_list(store, args)
    locale.setlocale(locale.LC_ALL, "")

    def run(scr):
        r = Review(scr, store)
        r.autotalk = args.cmd == "talk"
        if r.autotalk and r.mic and not r.mic.ready():
            r.flash = r.mic.hint() + "; talking starts once it connects"
        r.run()
    curses.wrapper(run)
    print(summary(store.read()))
    print(store.path)


# ---------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(prog="journeymaxx", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-f", "--file", help="path to the .journeymaxx file (default: nearest one "
                   "above the current directory, else the repo root)")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("review", help="review journeys (the default)")
    sub.add_parser("talk", help="review by voice: it reads each journey out and you answer")

    a = sub.add_parser("add", help="queue journeys from stdin (markdown split by ---, or JSON)")
    a.add_argument("--title", help="add a single journey with this title; stdin is its body")
    a.add_argument("--body")

    r = sub.add_parser("revise", help="replace a journey's text (stdin) and put it back to pending")
    r.add_argument("id", type=int)
    r.add_argument("--title")
    r.add_argument("--body")
    r.add_argument("-m", "--message", help="note shown to the reviewer")

    y = sub.add_parser("reply", help="leave a note on a journey; it does NOT go back to the reviewer")
    y.add_argument("id", type=int)
    y.add_argument("message")

    q = sub.add_parser("ask", help="question, pushback or contradiction the reviewer must answer; "
                       "back to pending")
    q.add_argument("id", type=int)
    q.add_argument("message")

    fb = sub.add_parser("feedback", help="print reviewer activity not yet read, and mark it read")
    fb.add_argument("--peek", action="store_true", help="do not mark it read")
    fb.add_argument("--json", action="store_true")

    w = sub.add_parser("wait", help="block until a comment, edit or rejection arrives (or nothing "
                       "is pending), then print feedback")
    w.add_argument("--timeout", type=int, default=0, help="seconds; exit 2 when it passes")
    w.add_argument("--json", action="store_true")

    ls = sub.add_parser("list", help="one line per journey")
    ls.add_argument("--status", choices=STATUSES)
    ls.add_argument("--json", action="store_true")

    s = sub.add_parser("show", help="one journey with its thread")
    s.add_argument("id", type=int)

    x = sub.add_parser("export", help="journeys as markdown")
    x.add_argument("--status", choices=STATUSES + ("all",), default="approved")

    t = sub.add_parser("transcribe", help="speech to text for an audio file (checks the ElevenLabs key)")
    t.add_argument("audio")

    args = p.parse_args()
    store = Store(find_file(args.file))
    handler = {"add": cmd_add, "revise": cmd_revise, "reply": cmd_reply, "ask": cmd_ask, "feedback": cmd_feedback,
               "wait": cmd_wait, "list": cmd_list, "show": cmd_show, "export": cmd_export,
               "transcribe": cmd_transcribe, "review": cmd_review, "talk": cmd_review, None: cmd_review}[args.cmd]
    try:
        handler(store, args)
    except ValueError as e:
        sys.exit(f"journeymaxx: {store.path} is not valid JSON ({e})")
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
