KEY_FILE = os.path.expanduser("~/.config/journeymaxx/elevenlabs_api_key")
STT_URL = "https://api.elevenlabs.io/v1/speech-to-text"
STT_MODEL = os.environ.get("JOURNEYMAXX_STT_MODEL", "scribe_v2")
MIC_PORT = int(os.environ.get("JOURNEYMAXX_MIC_PORT", "8737"))


class VoiceError(Exception):
    pass


def api_key():
    key = os.environ.get("ELEVENLABS_API_KEY", "").strip()
    if not key:
        try:
            with open(KEY_FILE, encoding="utf-8") as f:
                key = f.read().strip()
        except FileNotFoundError:
            pass
    if not key:
        raise VoiceError(f"no ElevenLabs key: set ELEVENLABS_API_KEY or put it in {KEY_FILE}")
    return key


def transcribe(audio, content_type="audio/wav"):
    """Speech to text with ElevenLabs Scribe. Returns the transcript."""
    ext = {"webm": "webm", "ogg": "ogg", "mp4": "mp4", "mpeg": "mp3", "wav": "wav"}
    name = "speech." + next((v for k, v in ext.items() if k in content_type), "wav")
    boundary = uuid.uuid4().hex
    parts = []
    for field, value in (("model_id", STT_MODEL), ("tag_audio_events", "false")):
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{field}"\r\n\r\n{value}\r\n'.encode())
    parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{name}"\r\n'
                 f"Content-Type: {content_type}\r\n\r\n".encode() + audio + b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode())
    req = urllib.request.Request(STT_URL, data=b"".join(parts), method="POST", headers={
        "xi-api-key": api_key(), "Content-Type": f"multipart/form-data; boundary={boundary}"})
    try:
        with urllib.request.urlopen(req, timeout=90) as r:
            return json.loads(r.read()).get("text", "").strip()
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")
        try:
            d = json.loads(detail)["detail"]
            detail = d.get("message", d) if isinstance(d, dict) else d
        except (ValueError, KeyError, TypeError):
            pass
        raise VoiceError(f"ElevenLabs {e.code}: {str(detail)[:160]}")
    except (urllib.error.URLError, OSError) as e:
        raise VoiceError(f"could not reach ElevenLabs: {e}")


class LocalMic:
    """Records from this machine's microphone with ffmpeg."""
    kind = "local"

    def __init__(self):
        self.proc, self.path = None, None
        self.requested = self.stop_requested = False

    def ready(self):
        return True

    def hint(self):
        return ""

    def start(self):
        if sys.platform == "darwin":
            src = ["-f", "avfoundation", "-i", os.environ.get("JOURNEYMAXX_MIC_DEVICE", ":0")]
        else:
            src = ["-f", "pulse", "-i", os.environ.get("JOURNEYMAXX_MIC_DEVICE", "default")]
        fd, self.path = tempfile.mkstemp(prefix="journeymaxx-", suffix=".wav")
        os.close(fd)
        try:
            self.proc = subprocess.Popen(
                ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", *src,
                 "-ac", "1", "-ar", "16000", self.path],
                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        except OSError as e:
            raise VoiceError(f"could not start ffmpeg: {e}")
        time.sleep(0.3)
        if self.proc.poll() is not None:
            os.unlink(self.path)
            err = self.proc.stderr.read().decode("utf-8", "replace").strip().splitlines()
            raise VoiceError("no microphone: " + (err[-1] if err else "ffmpeg exited") +
                             " (JOURNEYMAXX_MIC=browser records in a browser instead)")

    def stop(self):
        try:
            self.proc.communicate(b"q", timeout=5)
        except subprocess.TimeoutExpired:
            self.proc.kill()
            self.proc.wait()
        try:
            with open(self.path, "rb") as f:
                return f.read(), "audio/wav"
        finally:
            os.unlink(self.path)

    def cancel(self):
        if self.proc and self.proc.poll() is None:
            self.proc.kill()
            self.proc.wait()
        if self.path and os.path.exists(self.path):
            os.unlink(self.path)


