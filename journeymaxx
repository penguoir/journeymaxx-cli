class VoiceError(Exception):
    pass


def api_key():
    key = os.environ.get("ELEVENLABS_API_KEY", "").strip()
    if not key:
        try:
            with open(KEY_FILE, encoding="utf-8") as f:
                key = f.read().strip()
        except FileNotFoundError:
            pass
    if not key:
        raise VoiceError(f"no ElevenLabs key: set ELEVENLABS_API_KEY or put it in {KEY_FILE}")
    return key


def eleven(path, data, headers, timeout):
    req = urllib.request.Request(API + path, data=data, method="POST",
                                 headers={"xi-api-key": api_key(), **headers})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")
        try:
            d = json.loads(detail)["detail"]
            detail = d.get("message", d) if isinstance(d, dict) else d
        except (ValueError, KeyError, TypeError):
            pass
        raise VoiceError(f"ElevenLabs {e.code}: {str(detail)[:160]}")
    except (urllib.error.URLError, OSError) as e:
        raise VoiceError(f"could not reach ElevenLabs: {e}")


def transcribe(audio, content_type="audio/wav"):
    """Speech to text with ElevenLabs Scribe. Returns the transcript."""
    ext = {"webm": "webm", "ogg": "ogg", "mp4": "mp4", "mpeg": "mp3", "wav": "wav"}
    name = "speech." + next((v for k, v in ext.items() if k in content_type), "wav")
    boundary = uuid.uuid4().hex
    parts = []
    for field, value in (("model_id", STT_MODEL), ("tag_audio_events", "false")):
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{field}"\r\n\r\n{value}\r\n'.encode())
    parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{name}"\r\n'
                 f"Content-Type: {content_type}\r\n\r\n".encode() + audio + b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode())
    body = eleven("/speech-to-text", b"".join(parts),
                  {"Content-Type": f"multipart/form-data; boundary={boundary}"}, 90)
    return json.loads(body).get("text", "").strip()


class Speech:
    """Text to speech. By default None: the mic reads with a free voice (the browser's, `say` on
    macOS, espeak on Linux). With JOURNEYMAXX_TTS=elevenlabs, ElevenLabs audio cached on disk,
    falling back to the free voice when it fails."""

    def __init__(self):
        self.lock = threading.Lock()
        self.failed = ""  # set once ElevenLabs refuses; the rest of the session uses the fallback
        self.blip = ""

    def path(self, text):
        import hashlib
        h = hashlib.sha1(f"{VOICE_ID}|{TTS_MODEL}|{SPEED}|{text}".encode()).hexdigest()
        return os.path.join(TTS_CACHE, h + ".mp3")

    def audio(self, text):
        if TTS != "elevenlabs":
            return None
        p = self.path(text)
        if os.path.exists(p):
            return p
        if self.failed:
            return None
        for attempt in range(2):
            try:
                mp3 = eleven(f"/text-to-speech/{VOICE_ID}?output_format=mp3_44100_64",
                             json.dumps({"text": text, "model_id": TTS_MODEL,
                                         "voice_settings": {"speed": SPEED}}).encode(),
                             {"Content-Type": "application/json"}, 60)
                break
            except VoiceError as e:
                msg = str(e)
                if re.search(r"ElevenLabs (401|402|403)|quota|credits", msg, re.I):
                    with self.lock:  # out of quota or a bad key: stop asking for this session
                        self.failed = self.failed or msg
                    return None
                if attempt:  # busy or a blip: the free voice reads this one sentence
                    self.blip = msg
                    return None
                time.sleep(0.6)
        os.makedirs(TTS_CACHE, exist_ok=True)
        tmp = f"{p}.{os.getpid()}.{threading.get_ident()}"
        with open(tmp, "wb") as f:
            f.write(mp3)
        os.replace(tmp, p)
        return p

    def prefetch(self, *texts):
        def run():
            for t in texts:
                self.audio(t)
        threading.Thread(target=run, daemon=True).start()


SPEECH = Speech()


def speakable(md):
    """Light markdown to sentences a voice can read."""
    out = []
    for line in md.splitlines():
        line = re.sub(r"^\s*([-*•]|\d+[.)]|#+)\s+", "", line)
        line = line.replace("**", "").replace("`", "").strip()
        if line:
            out.append(line if line[-1] in ".!?:;" else line + ".")
    return " ".join(out)


def which(cmd):
    return subprocess.call(["sh", "-c", f"command -v {cmd}"], stdout=subprocess.DEVNULL) == 0


class LocalMic:
    """This machine's microphone and speakers: ffmpeg records, afplay/ffplay play."""
    kind = "local"

    def __init__(self):
        self.proc, self.path, self.player = None, None, None
        self.requested = self.stop_requested = self.heard = False

    def ready(self):
        return True

    def hint(self):
        return ""

    def start(self, auto=False):
        if sys.platform == "darwin":
            src = ["-f", "avfoundation", "-i", os.environ.get("JOURNEYMAXX_MIC_DEVICE", ":0")]
        else:
            src = ["-f", "pulse", "-i", os.environ.get("JOURNEYMAXX_MIC_DEVICE", "default")]
        if os.environ.get("JOURNEYMAXX_MIC_INPUT"):  # any ffmpeg input, e.g. "-re -i test.wav"
            src = shlex.split(os.environ["JOURNEYMAXX_MIC_INPUT"])
        vad = ["-af", f"silencedetect=noise=-35dB:d={PAUSE}"] if auto else []
        fd, self.path = tempfile.mkstemp(prefix="journeymaxx-", suffix=".wav")
        os.close(fd)
        self.stop_requested = self.heard = False
        self.err = []
        try:
            self.proc = subprocess.Popen(
                ["ffmpeg", "-hide_banner", "-nostats", "-loglevel", "info" if auto else "error", "-y",
                 *src, *vad, "-ac", "1", "-ar", "16000", self.path],
                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        except OSError as e:
            os.unlink(self.path)
            raise VoiceError(f"could not start ffmpeg: {e}")
        threading.Thread(target=self.read_stderr, args=(self.proc,), daemon=True).start()
        time.sleep(0.3)
        if self.proc.poll() is not None:
            os.unlink(self.path)
            time.sleep(0.1)
            raise VoiceError("no microphone: " + (self.err[-1] if self.err else "ffmpeg exited") +
                             " (JOURNEYMAXX_MIC=browser records in a browser instead)")

    def read_stderr(self, proc):
        for raw in proc.stderr:
            line = raw.decode("utf-8", "replace").strip()
            self.err.append(line)
            if "silence_end" in line:
                self.heard = True
            m = re.search(r"silence_start: ([\d.]+)", line)
            if m and (self.heard or float(m.group(1)) > 0.4):  # quiet after talking
                self.heard = self.stop_requested = True

    def stop(self):
        try:
            self.proc.stdin.write(b"q")
            self.proc.stdin.close()
            self.proc.wait(timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            self.proc.kill()
            self.proc.wait()
        try:
            with open(self.path, "rb") as f:
                return f.read(), "audio/wav"
        finally:
            os.unlink(self.path)

    def cancel(self):
        if self.proc and self.proc.poll() is None:
            self.proc.kill()
            self.proc.wait()
        if self.path and os.path.exists(self.path):
            os.unlink(self.path)

    def say(self, text):
        self.hush()
        p = SPEECH.audio(text)
        if p:
            cmd = ["afplay", p] if sys.platform == "darwin" else \
                ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", p]
        elif sys.platform == "darwin":
            cmd = ["say", "-r", "200", text]
        elif which("espeak-ng") or which("espeak"):
            cmd = ["espeak-ng" if which("espeak-ng") else "espeak", text]
        else:
            return
        try:
            self.player = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                           stderr=subprocess.DEVNULL)
        except OSError as e:
            raise VoiceError(f"could not play audio: {e}")

    def speaking(self):
        return self.player is not None and self.player.poll() is None

    def hush(self):
        if self.speaking():
            self.player.kill()
            self.player.wait()


