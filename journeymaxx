class BrowserMic:
    """For an SSH session with no microphone: a page on localhost records in your browser."""
    kind = "browser"

    def __init__(self):
        self.cv = threading.Condition()
        self.seq, self.recording, self.last_seen = 0, False, 0.0
        self.audio = {}
        self.requested = self.stop_requested = False
        mic = self
        for port in range(MIC_PORT, MIC_PORT + 10):
            try:
                self.server = ThreadingHTTPServer(("127.0.0.1", port), self.handler(mic))
                break
            except OSError:
                continue
        else:
            raise VoiceError(f"ports {MIC_PORT}-{MIC_PORT + 9} are all in use")
        self.server.daemon_threads = True
        self.port = self.server.server_address[1]
        self.url = f"http://localhost:{self.port}"
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    @staticmethod
    def handler(mic):
        class H(BaseHTTPRequestHandler):
            def log_message(self, *a):  # stderr would draw over the TUI
                pass

            def send(self, code, body, ctype="application/json"):
                body = body.encode() if isinstance(body, str) else body
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)

            def query(self):
                return dict(urllib.parse.parse_qsl(urllib.parse.urlparse(self.path).query))

            def local_origin(self):
                origin = self.headers.get("Origin")
                return not origin or urllib.parse.urlparse(origin).hostname in ("localhost", "127.0.0.1")

            def do_GET(self):
                route = urllib.parse.urlparse(self.path).path
                if route == "/":
                    return self.send(200, MIC_PAGE, "text/html; charset=utf-8")
                if route == "/poll":
                    q = self.query()
                    have = (int(q.get("seq", 0) or 0), q.get("rec") == "1")
                    with mic.cv:
                        mic.last_seen = time.time()
                        mic.cv.wait_for(lambda: (mic.seq, mic.recording) != have, timeout=20)
                        mic.last_seen = time.time()
                        state = {"seq": mic.seq, "recording": mic.recording}
                    return self.send(200, json.dumps(state))
                self.send(404, "{}")

            def do_POST(self):
                if not self.local_origin():
                    return self.send(403, "{}")
                route = urllib.parse.urlparse(self.path).path
                body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
                with mic.cv:
                    if route == "/toggle":
                        if mic.recording:
                            mic.stop_requested = True
                        else:
                            mic.requested = True
                    elif route == "/audio":
                        q = self.query()
                        mic.audio[int(q.get("seq", 0) or 0)] = (
                            body, self.headers.get("Content-Type", "audio/webm"), q.get("error"))
                    else:
                        return self.send(404, "{}")
                    mic.cv.notify_all()
                self.send(200, "{}")
        return H

    def ready(self):
        return time.time() - self.last_seen < 30

    def hint(self):
        return (f"open {self.url} in a browser to talk (over SSH forward it first: "
                f"ssh -L {self.port}:localhost:{self.port} <this host>)")

    def start(self):
        if not self.ready():
            raise VoiceError(self.hint())
        with self.cv:
            self.seq += 1
            self.recording, self.requested, self.stop_requested = True, False, False
            self.cv.notify_all()

    def stop(self):
        with self.cv:
            self.recording = False
            self.cv.notify_all()
            n = self.seq
            if not self.cv.wait_for(lambda: n in self.audio, timeout=20):
                raise VoiceError("the browser did not send the recording")
            audio, ctype, err = self.audio.pop(n)
        if err:
            raise VoiceError(f"browser microphone: {err}")
        return audio, ctype

    def cancel(self):
        with self.cv:
            self.recording = self.stop_requested = False
            self.audio.clear()
            self.cv.notify_all()


def make_mic():
    """JOURNEYMAXX_MIC=local|browser; by default the browser over SSH, else this machine."""
    choice = os.environ.get("JOURNEYMAXX_MIC", "").lower()
    if not choice:
        over_ssh = os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY")
        no_ffmpeg = subprocess.call(["sh", "-c", "command -v ffmpeg"], stdout=subprocess.DEVNULL) != 0
        choice = "browser" if over_ssh or no_ffmpeg else "local"
    return BrowserMic() if choice == "browser" else LocalMic()


# ---------------------------------------------------------------- TUI

def md_lines(text, width, base=0):
    """Wrap light markdown (bullets, **bold**, # headings) into rows of (text, attr) segments."""
    rows = []
    for raw in text.splitlines():
        if not raw.strip():
            rows.append([])
            continue
        attr = base
        first, rest = "", ""
        m = re.match(r"^(\s*)([-*•]|\d+[.)])\s+", raw)
        h = re.match(r"^#+\s+", raw)
        if m:
            marker = "•" if m.group(2) in "-*•" else m.group(2)
            first = m.group(1) + marker + " "
            rest = " " * len(first)
            raw = raw[m.end():]
        elif h:
            raw = raw[h.end():]
            attr |= curses.A_BOLD
        tokens = []  # (word, attr, space_before)
        for n, part in enumerate(raw.split("**")):
            a = attr | (curses.A_BOLD if n % 2 else 0)
            for piece in re.findall(r"\s+|\S+", part):
                if piece.isspace():
                    tokens.append(None)
                else:
                    tokens.append((piece, a))
        row, used, gap = [(first, base)] if first else [], len(first), False
        start = used  # where words begin on the current row
        for tok in tokens:
            if tok is None:
                gap = True
                continue
            word, a = tok
            lead = " " if gap and used > start else ""
            if used + len(lead) + len(word) > width and used > start:
                rows.append(row)
                row, used, lead = ([(rest, base)] if rest else []), len(rest), ""
                start = used
            row.append((lead + word, a))
            used += len(lead) + len(word)
            gap = False
        rows.append(row)
    return rows


class Review:
    def __init__(self, scr, store):
        self.scr = scr
        self.store = store
        self.data = empty()
        self.mtime = None
        self.cur = None       # id of the journey on screen; None = caught-up screen
        self.scroll = 0
        self.diff = False
        self.flash = ""
        self.color = {}
        self.mic = None
        self.mic_error = ""
        try:
            self.mic = make_mic()
        except VoiceError as e:
            self.mic_error = str(e)

    # -- state

    def reload(self):
        self.mtime = self.store.mtime()
        try:
            self.data = self.store.read()
        except ValueError:
            self.flash = "could not read the file (invalid JSON)"

    def journey(self):
        return find(self.data, self.cur) if self.cur is not None else None

    def goto(self, jid):
        if jid != self.cur:
            self.cur, self.scroll, self.diff = jid, 0, False

    def next_pending(self):
        js = self.data["journeys"]
        idx = next((i for i, j in enumerate(js) if j["id"] == self.cur), -1)
        order = js[idx + 1:] + js[:idx + 1]
        nxt = next((j for j in order if j["status"] == "pending" and j["id"] != self.cur), None)
        self.goto(nxt["id"] if nxt else None)

    def step(self, delta):
        js = self.data["journeys"]
        if not js:
            return
        idx = next((i for i, j in enumerate(js) if j["id"] == self.cur), None)
        if idx is None:
            idx = 0 if delta > 0 else len(js) - 1
        else:
            idx = max(0, min(len(js) - 1, idx + delta))
        self.goto(js[idx]["id"])

    def change(self, fn):
        jid = self.cur

        def wrapped(data):
            j = find(data, jid)
            if j is not None:
                fn(j)

        self.store.mutate(wrapped)
        self.reload()

    # -- actions

    def approve(self):
        j = self.journey()
        if j is None:
            return
        if j["status"] != "approved":
            self.change(lambda j: (set_status(j, "approved"), event(j, "reviewer", "approved")))
            self.flash = f"#{j['id']} approved"
        self.next_pending()

    def comment(self, initial=""):
        j = self.journey()
        if j is None:
            return
        text = self.prompt(f"Message to Claude about #{j['id']}", initial=initial)
        if not text:
            return
        self.change(lambda j: (set_status(j, "changes_requested"),
                               event(j, "reviewer", "comment", message=text)))
        self.flash = f"#{j['id']} sent to Claude"
        self.next_pending()

    def listen(self):
        """Record until enter, transcribe, return the text (None when cancelled or failed)."""
        if self.mic is None:
            self.flash = self.mic_error
            return None
        try:
            self.mic.start()
        except VoiceError as e:
            self.mic.requested = False
            self.flash = str(e)
            return None
        started = time.time()
        self.scr.timeout(200)
        try:
            while True:
                self.status_line(f"● Listening {int(time.time() - started)}s",
                                 "enter stop and send to the message box · esc cancel", "rejected")
                try:
                    ch = self.scr.get_wch()
                except curses.error:
                    ch = None
                except KeyboardInterrupt:
                    ch = "\x1b"
                if ch == "\x1b":
                    self.mic.cancel()
                    self.flash = "recording cancelled"
                    return None
                if ch in ("\n", "\r", curses.KEY_ENTER, "v", " ") or self.mic.stop_requested:
                    break
            self.status_line("Transcribing…", "", "claude")
            audio, ctype = self.mic.stop()
            text = transcribe(audio, ctype)
        except VoiceError as e:
            self.mic.cancel()
            self.flash = str(e)
            return None
        finally:
            self.scr.timeout(400)
        if not text:
            self.flash = "did not catch anything; press v to try again"
            return None
        return text

    def voice(self):
        if self.journey() is None:
            if self.mic:
                self.mic.requested = False
            return
        text = self.listen()
        if text:
            self.comment(initial=text)

    def status_line(self, msg, keys, color):
        self.draw()
        h, _ = self.scr.getmaxyx()
        for y in (h - 2, h - 1):
            self.scr.move(y, 0)
            self.scr.clrtoeol()
        self.put(h - 2, 2, msg, self.color.get(color, 0) | curses.A_BOLD)
        self.put(h - 1, 1, keys, curses.A_DIM)
        self.scr.refresh()

    def reject(self):
        j = self.journey()
        if j is None:
            return
        text = self.prompt(f"Reject #{j['id']}: reason (enter to skip)", allow_empty=True)
        if text is None:
            return
        self.change(lambda j: (set_status(j, "rejected"),
                               event(j, "reviewer", "rejected", message=text or None)))
        self.flash = f"#{j['id']} rejected"
        self.next_pending()

    def reopen(self):
        j = self.journey()
        if j is None or j["status"] == "pending":
            return
        self.change(lambda j: (set_status(j, "pending"), event(j, "reviewer", "reopened")))
        self.flash = f"#{j['id']} back to pending"

    def edit(self):
        j = self.journey()
        if j is None:
            return
        new = self.editor(f"# {j['title']}\n\n{j['body']}\n")
        if new is None:
            return
        title, body = split_title(new)
        if (title, body) == (j["title"], j["body"]):
            self.flash = "no changes"
            return

        def fn(j):
            prev_title, prev_body = j["title"], j["body"]
            j["title"], j["body"] = title, body
            event(j, "reviewer", "edited", previous_title=prev_title, previous_body=prev_body)

        self.change(fn)
        self.flash = f"#{j['id']} edited · enter to approve"

    def editor(self, text):
        cmd = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vim")
        fd, path = tempfile.mkstemp(prefix="journeymaxx-", suffix=".md")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(text)
            curses.endwin()
            try:
                code = subprocess.call(cmd + [path])
            except OSError as e:
                self.flash = f"could not start {cmd[0]}: {e}"
                return None
            finally:
                self.scr.refresh()
                curses.curs_set(0)
            if code != 0:
                self.flash = "edit cancelled"
                return None
            with open(path, encoding="utf-8") as f:
                return f.read()
        finally:
            os.unlink(path)

    # -- drawing

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w - 1:
            try:
                self.scr.addnstr(y, x, text, w - 1 - x, attr)
            except curses.error:
                pass

    def status_attr(self, status):
        return self.color.get(status, 0) | curses.A_BOLD

    def content(self, j, width):
        dim = curses.A_DIM
        rows = md_lines(f"#{j['id']}  {j['title']}", width, curses.A_BOLD)
        badge = [(LABELS[j["status"]], self.status_attr(j["status"]))]
        last = j["history"][-1] if j["history"] else None
        if last and last["by"] == "claude" and last["action"] in ("revised", "reply", "question"):
            what = {"revised": "revised", "reply": "left a note", "question": "has a question"}[last["action"]]
            badge.append((f"  · Claude {what} {hhmm(last['at'])}", self.color.get("claude", 0)))
        rows += [badge, []]

        prev = next((e for e in reversed(j["history"]) if "previous_body" in e), None)
        if self.diff and prev:
            old = f"{prev.get('previous_title', '')}\n\n{prev['previous_body']}".splitlines()
            new = f"{j['title']}\n\n{j['body']}".splitlines()
            for line in difflib.ndiff(old, new):
                if line.startswith("?"):
                    continue
                attr = {"+": self.color.get("approved", 0), "-": self.color.get("rejected", 0)}.get(line[0], dim)
                for n, part in enumerate(textwrap.wrap(line[2:], width - 2) or [""]):
                    rows.append([((line[0] if n == 0 else " ") + " " + part, attr)])
        else:
            rows += md_lines(j["body"], width)

        thread = [e for e in j["history"] if e["action"] != "added"]
        if thread:
            rows += [[], [("─" * min(width, 40), dim)]]
        for e in thread:
            who = "you" if e["by"] == "reviewer" else "claude"
            attr = 0 if e["by"] == "reviewer" else self.color.get("claude", 0)
            head = f"{hhmm(e['at'])} {who} {e['action'].replace('_', ' ')}"
            if e.get("message"):
                msg = md_lines(e["message"], width - 4)
                rows.append([(head + ":", attr | curses.A_BOLD)])
                rows += [[("    ", 0)] + r for r in msg]
            else:
                rows.append([(head, attr | dim)])
        return rows, bool(prev)

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        width = max(20, min(w - 4, 92))
        js = self.data["journeys"]
        j = self.journey()

        pos = ""
        if j is not None:
            pos = f"{next(i for i, x in enumerate(js) if x['id'] == j['id']) + 1}/{len(js)}"
        self.put(0, 1, "journeymaxx", curses.A_BOLD)
        self.put(0, 14, summary(self.data), curses.A_DIM)
        self.put(0, max(14, w - len(pos) - 2), pos, curses.A_DIM)
        if self.mic and self.mic.kind == "browser":
            mic = "mic ready" if self.mic.ready() else f"mic: open {self.mic.url}"
            self.put(1, max(14, w - len(mic) - 2), mic, curses.A_DIM)

        keys = "↑↓ move · q quit"
        if j is None:
            if not js:
                msg, sub = "No journeys yet.", f"Waiting for Claude to add some to {self.store.path}"
            else:
                msg, sub = "All caught up.", "New and revised journeys show up here as Claude adds them."
            self.put(h // 2 - 1, 2, msg, curses.A_BOLD)
            self.put(h // 2, 2, sub, curses.A_DIM)
        else:
            rows, has_prev = self.content(j, width)
            avail = max(1, h - 5)
            self.scroll = max(0, min(self.scroll, len(rows) - avail))
            for n, row in enumerate(rows[self.scroll:self.scroll + avail]):
                x = 2
                for text, attr in row:
                    self.put(2 + n, x, text, attr)
                    x += len(text)
            if self.scroll + avail < len(rows):
                self.put(h - 3, 2, "▼ more (space)", curses.A_DIM)
            keys = ("enter approve · c message Claude · v speak · ^G edit · r reject · u undo"
                    + (" · d diff" if has_prev else "") + " · ↑↓ move · n next pending · q quit")
        if self.flash:
            self.put(h - 2, 2, self.flash, self.color.get("approved", 0))
        self.put(h - 1, 1, keys, curses.A_DIM)
        scr.refresh()

    def prompt(self, label, allow_empty=False, initial=""):
        """One-field input at the bottom. Returns the text, or None when cancelled."""
        buf = initial
        self.scr.timeout(-1)
        curses.curs_set(1)
        try:
            while True:
                self.draw()
                h, w = self.scr.getmaxyx()
                width = max(10, w - 6)
                lines = []
                for para in (buf + "█").split("\n"):
                    lines += textwrap.wrap(para, width, drop_whitespace=False) or [""]
                lines = lines[-max(1, h - 6):]
                top = h - len(lines) - 3
                for y in range(top, h):
                    self.scr.move(max(0, y), 0)
                    self.scr.clrtoeol()
                self.put(top, 1, label, curses.A_BOLD)
                for n, line in enumerate(lines):
                    self.put(top + 1 + n, 1, "> " if n == 0 else "  ", curses.A_DIM)
                    self.put(top + 1 + n, 3, line.replace("█", ""))
                last = lines[-1].replace("█", "")
                self.put(h - 1, 1, "enter send · esc cancel · ^R speak · ^G write in editor", curses.A_DIM)
                try:
                    self.scr.move(top + len(lines), min(w - 2, 3 + len(last)))
                except curses.error:
                    pass
                self.scr.refresh()
                try:
                    ch = self.scr.get_wch()
                except curses.error:
                    continue
                except KeyboardInterrupt:
                    return None
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    text = buf.strip()
                    if text or allow_empty:
                        return text
                    return None
                if ch == "\x1b":
                    return None
                if ch == "\x07":
                    edited = self.editor(buf)
                    if edited is not None:
                        buf = edited.strip()
                elif ch == "\x12":
                    curses.curs_set(0)
                    said = self.listen()
                    self.scr.timeout(-1)
                    curses.curs_set(1)
                    if said:
                        buf = (buf.rstrip() + " " + said).strip()
                elif ch in ("\x7f", "\b", curses.KEY_BACKSPACE):
                    buf = buf[:-1]
                elif ch == "\x15":
                    buf = ""
                elif ch == "\x17":
                    buf = re.sub(r"\S*\s*$", "", buf)
                elif isinstance(ch, str) and ch.isprintable():
                    buf += ch
        finally:
            curses.curs_set(0)
            self.scr.timeout(400)

    # -- loop

    def run(self):
        curses.curs_set(0)
        curses.set_escdelay(25)
        try:
            curses.use_default_colors()
            for n, (name, col) in enumerate([("approved", curses.COLOR_GREEN),
                                             ("changes_requested", curses.COLOR_YELLOW),
                                             ("rejected", curses.COLOR_RED),
                                             ("pending", curses.COLOR_CYAN),
                                             ("claude", curses.COLOR_MAGENTA)], start=1):
                curses.init_pair(n, col, -1)
                self.color[name] = curses.color_pair(n)
        except curses.error:
            pass
        self.scr.timeout(400)
        self.reload()
        self.next_pending()
        while True:
            if self.store.mtime() != self.mtime:
                self.reload()
            if self.cur is not None and self.journey() is None:
                self.cur = None
            if self.cur is None:
                self.next_pending()  # jump to new work as soon as Claude adds it
            if self.mic and self.mic.requested:  # "Speak" pressed on the mic page
                self.voice()
                continue
            self.draw()
            try:
                ch = self.scr.get_wch()
            except curses.error:
                continue
            except KeyboardInterrupt:
                return
            self.flash = ""
            if ch in ("q", "Q"):
                return
            elif ch in ("\n", "\r", curses.KEY_ENTER):
                self.approve()
            elif ch in ("c", "C"):
                self.comment()
            elif ch in ("v", "V"):
                self.voice()
            elif ch in ("\x07", "e"):
                self.edit()
            elif ch == "r":
                self.reject()
            elif ch == "u":
                self.reopen()
            elif ch == "d":
                self.diff, self.scroll = not self.diff, 0
            elif ch in ("j", curses.KEY_DOWN, curses.KEY_RIGHT):
                self.step(1)
            elif ch in ("k", curses.KEY_UP, curses.KEY_LEFT):
                self.step(-1)
            elif ch == "n":
                self.next_pending()
            elif ch == "g":
                self.cur = None
                self.step(1)
            elif ch == "G":
                self.cur = None
                self.step(-1)
            elif ch in (" ", curses.KEY_NPAGE):
                self.scroll += max(1, self.scr.getmaxyx()[0] - 7)
            elif ch in ("b", curses.KEY_PPAGE):
                self.scroll = max(0, self.scroll - max(1, self.scr.getmaxyx()[0] - 7))


def cmd_transcribe(store, args):
    ctype = {".webm": "audio/webm", ".ogg": "audio/ogg", ".mp3": "audio/mpeg", ".mp4": "audio/mp4",
             ".m4a": "audio/mp4"}.get(os.path.splitext(args.audio)[1].lower(), "audio/wav")
    try:
        with open(args.audio, "rb") as f:
            print(transcribe(f.read(), ctype))
    except (OSError, VoiceError) as e:
        sys.exit(f"journeymaxx: {e}")


def cmd_review(store, args):
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        args.status, args.json = None, False
        return cmd_list(store, args)
    locale.setlocale(locale.LC_ALL, "")
    curses.wrapper(lambda scr: Review(scr, store).run())
    print(summary(store.read()))
    print(store.path)


# ---------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(prog="journeymaxx", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-f", "--file", help="path to the .journeymaxx file (default: nearest one "
                   "above the current directory, else the repo root)")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("review", help="review journeys (the default)")

    a = sub.add_parser("add", help="queue journeys from stdin (markdown split by ---, or JSON)")
    a.add_argument("--title", help="add a single journey with this title; stdin is its body")
    a.add_argument("--body")

    r = sub.add_parser("revise", help="replace a journey's text (stdin) and put it back to pending")
    r.add_argument("id", type=int)
    r.add_argument("--title")
    r.add_argument("--body")
    r.add_argument("-m", "--message", help="note shown to the reviewer")

    y = sub.add_parser("reply", help="leave a note on a journey; it does NOT go back to the reviewer")
    y.add_argument("id", type=int)
    y.add_argument("message")

    q = sub.add_parser("ask", help="question, pushback or contradiction the reviewer must answer; "
                       "back to pending")
    q.add_argument("id", type=int)
    q.add_argument("message")

    fb = sub.add_parser("feedback", help="print reviewer activity not yet read, and mark it read")
    fb.add_argument("--peek", action="store_true", help="do not mark it read")
    fb.add_argument("--json", action="store_true")

    w = sub.add_parser("wait", help="block until a comment, edit or rejection arrives (or nothing "
                       "is pending), then print feedback")
    w.add_argument("--timeout", type=int, default=0, help="seconds; exit 2 when it passes")
    w.add_argument("--json", action="store_true")

    ls = sub.add_parser("list", help="one line per journey")
    ls.add_argument("--status", choices=STATUSES)
    ls.add_argument("--json", action="store_true")

    s = sub.add_parser("show", help="one journey with its thread")
    s.add_argument("id", type=int)

    x = sub.add_parser("export", help="journeys as markdown")
    x.add_argument("--status", choices=STATUSES + ("all",), default="approved")

    t = sub.add_parser("transcribe", help="speech to text for an audio file (checks the ElevenLabs key)")
    t.add_argument("audio")

    args = p.parse_args()
    store = Store(find_file(args.file))
    handler = {"add": cmd_add, "revise": cmd_revise, "reply": cmd_reply, "ask": cmd_ask, "feedback": cmd_feedback,
               "wait": cmd_wait, "list": cmd_list, "show": cmd_show, "export": cmd_export,
               "transcribe": cmd_transcribe, "review": cmd_review, None: cmd_review}[args.cmd]
    try:
        handler(store, args)
    except ValueError as e:
        sys.exit(f"journeymaxx: {store.path} is not valid JSON ({e})")
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
